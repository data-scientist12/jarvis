# ---- server-only secrets (never prefix with NEXT_PUBLIC_) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MODEL_REVIEW=gpt-5.5
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
DAILY_TOKEN_BUDGET=2000000

# Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Extra allowed origins, comma separated (e.g. https://your-project.vercel.app)
TRUSTED_ORIGINS=

DATABASE_URL=postgres://postgres@localhost:5432/jarvis

# Google OAuth client (Web application) from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails allowed to sign up. In production an empty list blocks everyone.
ALLOWED_EMAILS=

# Secret for POST /api/cron/tick (openssl rand -hex 16)
CRON_SECRET=

# Rate limiting (recommended in production; falls back to in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
